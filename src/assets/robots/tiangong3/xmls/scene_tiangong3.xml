<mujoco model="scene_tiangong3">
  <default>
    <joint damping="0.05" armature="0.01" frictionloss="0.2"/>
  </default>

  <!-- Standalone torque actuators. MJLab injects its own position actuators
       when it loads tiangong3.xml, so these belong only to this scene. -->
  <actuator>
    <motor name="hip_pitch_l" joint="hip_pitch_l_joint" ctrlrange="-235 235"/>
    <motor name="hip_roll_l" joint="hip_roll_l_joint" ctrlrange="-235 235"/>
    <motor name="hip_yaw_l" joint="hip_yaw_l_joint" ctrlrange="-150 150"/>
    <motor name="knee_pitch_l" joint="knee_pitch_l_joint" ctrlrange="-400 400"/>
    <motor name="ankle_pitch_l" joint="ankle_pitch_l_joint" ctrlrange="-55 55"/>
    <motor name="ankle_roll_l" joint="ankle_roll_l_joint" ctrlrange="-55 55"/>
    <motor name="hip_pitch_r" joint="hip_pitch_r_joint" ctrlrange="-235 235"/>
    <motor name="hip_roll_r" joint="hip_roll_r_joint" ctrlrange="-235 235"/>
    <motor name="hip_yaw_r" joint="hip_yaw_r_joint" ctrlrange="-150 150"/>
    <motor name="knee_pitch_r" joint="knee_pitch_r_joint" ctrlrange="-400 400"/>
    <motor name="ankle_pitch_r" joint="ankle_pitch_r_joint" ctrlrange="-55 55"/>
    <motor name="ankle_roll_r" joint="ankle_roll_r_joint" ctrlrange="-55 55"/>
    <motor name="waist_yaw" joint="waist_yaw_joint" ctrlrange="-91 91"/>
    <motor name="waist_roll" joint="waist_roll_joint" ctrlrange="-150 150"/>
    <motor name="waist_pitch" joint="waist_pitch_joint" ctrlrange="-150 150"/>
    <motor name="shoulder_pitch_l" joint="shoulder_pitch_l_joint" ctrlrange="-90 90"/>
    <motor name="shoulder_roll_l" joint="shoulder_roll_l_joint" ctrlrange="-90 90"/>
    <motor name="shoulder_yaw_l" joint="shoulder_yaw_l_joint" ctrlrange="-50 50"/>
    <motor name="elbow_pitch_l" joint="elbow_pitch_l_joint" ctrlrange="-50 50"/>
    <motor name="elbow_yaw_l" joint="elbow_yaw_l_joint" ctrlrange="-25 25"/>
    <motor name="wrist_pitch_l" joint="wrist_pitch_l_joint" ctrlrange="-40 40"/>
    <motor name="wrist_roll_l" joint="wrist_roll_l_joint" ctrlrange="-40 40"/>
    <motor name="shoulder_pitch_r" joint="shoulder_pitch_r_joint" ctrlrange="-90 90"/>
    <motor name="shoulder_roll_r" joint="shoulder_roll_r_joint" ctrlrange="-90 90"/>
    <motor name="shoulder_yaw_r" joint="shoulder_yaw_r_joint" ctrlrange="-50 50"/>
    <motor name="elbow_pitch_r" joint="elbow_pitch_r_joint" ctrlrange="-50 50"/>
    <motor name="elbow_yaw_r" joint="elbow_yaw_r_joint" ctrlrange="-25 25"/>
    <motor name="wrist_pitch_r" joint="wrist_pitch_r_joint" ctrlrange="-40 40"/>
    <motor name="wrist_roll_r" joint="wrist_roll_r_joint" ctrlrange="-40 40"/>
  </actuator>

  <sensor>
    <jointpos name="hip_pitch_l_pos" joint="hip_pitch_l_joint"/>
    <jointpos name="hip_roll_l_pos" joint="hip_roll_l_joint"/>
    <jointpos name="hip_yaw_l_pos" joint="hip_yaw_l_joint"/>
    <jointpos name="knee_pitch_l_pos" joint="knee_pitch_l_joint"/>
    <jointpos name="ankle_pitch_l_pos" joint="ankle_pitch_l_joint"/>
    <jointpos name="ankle_roll_l_pos" joint="ankle_roll_l_joint"/>
    <jointpos name="hip_pitch_r_pos" joint="hip_pitch_r_joint"/>
    <jointpos name="hip_roll_r_pos" joint="hip_roll_r_joint"/>
    <jointpos name="hip_yaw_r_pos" joint="hip_yaw_r_joint"/>
    <jointpos name="knee_pitch_r_pos" joint="knee_pitch_r_joint"/>
    <jointpos name="ankle_pitch_r_pos" joint="ankle_pitch_r_joint"/>
    <jointpos name="ankle_roll_r_pos" joint="ankle_roll_r_joint"/>
    <jointpos name="waist_yaw_pos" joint="waist_yaw_joint"/>
    <jointpos name="waist_roll_pos" joint="waist_roll_joint"/>
    <jointpos name="waist_pitch_pos" joint="waist_pitch_joint"/>
    <jointpos name="shoulder_pitch_l_pos" joint="shoulder_pitch_l_joint"/>
    <jointpos name="shoulder_roll_l_pos" joint="shoulder_roll_l_joint"/>
    <jointpos name="shoulder_yaw_l_pos" joint="shoulder_yaw_l_joint"/>
    <jointpos name="elbow_pitch_l_pos" joint="elbow_pitch_l_joint"/>
    <jointpos name="elbow_yaw_l_pos" joint="elbow_yaw_l_joint"/>
    <jointpos name="wrist_pitch_l_pos" joint="wrist_pitch_l_joint"/>
    <jointpos name="wrist_roll_l_pos" joint="wrist_roll_l_joint"/>
    <jointpos name="shoulder_pitch_r_pos" joint="shoulder_pitch_r_joint"/>
    <jointpos name="shoulder_roll_r_pos" joint="shoulder_roll_r_joint"/>
    <jointpos name="shoulder_yaw_r_pos" joint="shoulder_yaw_r_joint"/>
    <jointpos name="elbow_pitch_r_pos" joint="elbow_pitch_r_joint"/>
    <jointpos name="elbow_yaw_r_pos" joint="elbow_yaw_r_joint"/>
    <jointpos name="wrist_pitch_r_pos" joint="wrist_pitch_r_joint"/>
    <jointpos name="wrist_roll_r_pos" joint="wrist_roll_r_joint"/>

    <jointvel name="hip_pitch_l_vel" joint="hip_pitch_l_joint"/>
    <jointvel name="hip_roll_l_vel" joint="hip_roll_l_joint"/>
    <jointvel name="hip_yaw_l_vel" joint="hip_yaw_l_joint"/>
    <jointvel name="knee_pitch_l_vel" joint="knee_pitch_l_joint"/>
    <jointvel name="ankle_pitch_l_vel" joint="ankle_pitch_l_joint"/>
    <jointvel name="ankle_roll_l_vel" joint="ankle_roll_l_joint"/>
    <jointvel name="hip_pitch_r_vel" joint="hip_pitch_r_joint"/>
    <jointvel name="hip_roll_r_vel" joint="hip_roll_r_joint"/>
    <jointvel name="hip_yaw_r_vel" joint="hip_yaw_r_joint"/>
    <jointvel name="knee_pitch_r_vel" joint="knee_pitch_r_joint"/>
    <jointvel name="ankle_pitch_r_vel" joint="ankle_pitch_r_joint"/>
    <jointvel name="ankle_roll_r_vel" joint="ankle_roll_r_joint"/>
    <jointvel name="waist_yaw_vel" joint="waist_yaw_joint"/>
    <jointvel name="waist_roll_vel" joint="waist_roll_joint"/>
    <jointvel name="waist_pitch_vel" joint="waist_pitch_joint"/>
    <jointvel name="shoulder_pitch_l_vel" joint="shoulder_pitch_l_joint"/>
    <jointvel name="shoulder_roll_l_vel" joint="shoulder_roll_l_joint"/>
    <jointvel name="shoulder_yaw_l_vel" joint="shoulder_yaw_l_joint"/>
    <jointvel name="elbow_pitch_l_vel" joint="elbow_pitch_l_joint"/>
    <jointvel name="elbow_yaw_l_vel" joint="elbow_yaw_l_joint"/>
    <jointvel name="wrist_pitch_l_vel" joint="wrist_pitch_l_joint"/>
    <jointvel name="wrist_roll_l_vel" joint="wrist_roll_l_joint"/>
    <jointvel name="shoulder_pitch_r_vel" joint="shoulder_pitch_r_joint"/>
    <jointvel name="shoulder_roll_r_vel" joint="shoulder_roll_r_joint"/>
    <jointvel name="shoulder_yaw_r_vel" joint="shoulder_yaw_r_joint"/>
    <jointvel name="elbow_pitch_r_vel" joint="elbow_pitch_r_joint"/>
    <jointvel name="elbow_yaw_r_vel" joint="elbow_yaw_r_joint"/>
    <jointvel name="wrist_pitch_r_vel" joint="wrist_pitch_r_joint"/>
    <jointvel name="wrist_roll_r_vel" joint="wrist_roll_r_joint"/>

    <jointactuatorfrc name="hip_pitch_l_torque" joint="hip_pitch_l_joint"/>
    <jointactuatorfrc name="hip_roll_l_torque" joint="hip_roll_l_joint"/>
    <jointactuatorfrc name="hip_yaw_l_torque" joint="hip_yaw_l_joint"/>
    <jointactuatorfrc name="knee_pitch_l_torque" joint="knee_pitch_l_joint"/>
    <jointactuatorfrc name="ankle_pitch_l_torque" joint="ankle_pitch_l_joint"/>
    <jointactuatorfrc name="ankle_roll_l_torque" joint="ankle_roll_l_joint"/>
    <jointactuatorfrc name="hip_pitch_r_torque" joint="hip_pitch_r_joint"/>
    <jointactuatorfrc name="hip_roll_r_torque" joint="hip_roll_r_joint"/>
    <jointactuatorfrc name="hip_yaw_r_torque" joint="hip_yaw_r_joint"/>
    <jointactuatorfrc name="knee_pitch_r_torque" joint="knee_pitch_r_joint"/>
    <jointactuatorfrc name="ankle_pitch_r_torque" joint="ankle_pitch_r_joint"/>
    <jointactuatorfrc name="ankle_roll_r_torque" joint="ankle_roll_r_joint"/>
    <jointactuatorfrc name="waist_yaw_torque" joint="waist_yaw_joint"/>
    <jointactuatorfrc name="waist_roll_torque" joint="waist_roll_joint"/>
    <jointactuatorfrc name="waist_pitch_torque" joint="waist_pitch_joint"/>
    <jointactuatorfrc name="shoulder_pitch_l_torque" joint="shoulder_pitch_l_joint"/>
    <jointactuatorfrc name="shoulder_roll_l_torque" joint="shoulder_roll_l_joint"/>
    <jointactuatorfrc name="shoulder_yaw_l_torque" joint="shoulder_yaw_l_joint"/>
    <jointactuatorfrc name="elbow_pitch_l_torque" joint="elbow_pitch_l_joint"/>
    <jointactuatorfrc name="elbow_yaw_l_torque" joint="elbow_yaw_l_joint"/>
    <jointactuatorfrc name="wrist_pitch_l_torque" joint="wrist_pitch_l_joint"/>
    <jointactuatorfrc name="wrist_roll_l_torque" joint="wrist_roll_l_joint"/>
    <jointactuatorfrc name="shoulder_pitch_r_torque" joint="shoulder_pitch_r_joint"/>
    <jointactuatorfrc name="shoulder_roll_r_torque" joint="shoulder_roll_r_joint"/>
    <jointactuatorfrc name="shoulder_yaw_r_torque" joint="shoulder_yaw_r_joint"/>
    <jointactuatorfrc name="elbow_pitch_r_torque" joint="elbow_pitch_r_joint"/>
    <jointactuatorfrc name="elbow_yaw_r_torque" joint="elbow_yaw_r_joint"/>
    <jointactuatorfrc name="wrist_pitch_r_torque" joint="wrist_pitch_r_joint"/>
    <jointactuatorfrc name="wrist_roll_r_torque" joint="wrist_roll_r_joint"/>

    <framequat name="imu_quat" objtype="site" objname="imu"/>
    <gyro name="imu_gyro" site="imu"/>
    <accelerometer name="imu_acc" site="imu"/>
    <framepos name="frame_pos" objtype="site" objname="imu"/>
    <framelinvel name="frame_vel" objtype="site" objname="imu"/>
  </sensor>

  <!-- Keep the standalone sensor block first so its flat layout matches G1.
       The included robot-only sensors remain available under their MJLab names. -->
  <include file="tiangong3.xml"/>

  <statistic center="0 0 1" extent="1.2"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1"
               specular="0.9 0.9 0.9"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-140" elevation="-20"/>
  </visual>
  <asset>
    <texture type="skybox" builtin="flat" rgb1="0 0 0" rgb2="0 0 0"
             width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
             markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.2"/>
  </asset>
  <worldbody>
    <light pos="1 0 3.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane"
          material="groundplane"/>
  </worldbody>
</mujoco>
